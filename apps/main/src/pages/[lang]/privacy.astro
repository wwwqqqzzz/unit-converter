---
// Privacy Policy (English only)
import BaseLayout from '../../layouts/BaseLayout.astro';

export const prerender = true;
export async function getStaticPaths() {
  return [{ params: { lang: 'en' } }];
}
---

<BaseLayout lang="en" title="Privacy Policy" description="ConvUnit privacy policy — we don't track what you convert, store personal data, or share information with third parties." pagePath="privacy">
  <article class="trust-page">
    <h1>Privacy Policy</h1>
    <p class="updated">Last updated: June 30, 2026</p>

    <section>
      <h2>Summary</h2>
      <p><strong>ConvUnit does not track what you convert.</strong> We don't store your conversions, we don't profile you, and we don't sell your data. Period.</p>
    </section>

    <section>
      <h2>Information We Collect</h2>
      <h3>Automatically Collected</h3>
      <p>When you visit ConvUnit, our infrastructure provider (Cloudflare) may log standard web server data:</p>
      <ul>
        <li>IP address (for serving pages, not for tracking)</li>
        <li>Browser type and version</li>
        <li>Referring URL</li>
        <li>Pages visited and time of visit</li>
      </ul>
      <p>This data is used solely for <strong>security and performance</strong> (DDoS protection, caching, analytics). It is not linked to your identity.</p>

      <h3>We Do NOT Collect</h3>
      <ul>
        <li>Conversion values you enter</li>
        <li>Search queries</li>
        <li>Personal information (name, email, phone)</li>
        <li>Account credentials (we have no accounts)</li>
        <li>Location data beyond IP-derived country</li>
      </ul>
    </section>

    <section>
      <h2>Cookies</h2>
      <p>ConvUnit uses minimal cookies:</p>
      <ul>
        <li><strong>Cloudflare analytics</strong>: Anonymous, aggregated page view data. No personal tracking.</li>
        <li><strong>Google AdSense</strong>: May set cookies for ad personalization. You can opt out via <a href="https://adssettings.google.com/" target="_blank" rel="noopener">Google Ad Settings</a>.</li>
      </ul>
      <p>We do <strong>not</strong> set any first-party tracking cookies.</p>
    </section>

    <section>
      <h2>Google Analytics</h2>
      <p>We use Google Analytics to understand aggregate usage patterns (which pages are popular, which browsers people use). We do <strong>not</strong> use it to track individual users or conversion values.</p>
      <p>Google Analytics data is anonymized (IP masking enabled) and we do not link it to any personal information.</p>
    </section>

    <section>
      <h2>Google AdSense</h2>
      <p>ConvUnit displays ads through Google AdSense. AdSense may use cookies to serve relevant ads. This is controlled by Google, not ConvUnit.</p>
      <p>You can opt out of personalized advertising through <a href="https://adssettings.google.com/" target="_blank" rel="noopener">Google Ad Settings</a>.</p>
    </section>

    <section>
      <h2>Third-Party Services</h2>
      <table class="services-table">
        <thead>
          <tr><th>Service</th><th>Purpose</th><th>Data</th></tr>
        </thead>
        <tbody>
          <tr><td>Cloudflare</td><td>Hosting, CDN, security</td><td>Server logs (IP, browser)</td></tr>
          <tr><td>Google Analytics</td><td>Aggregate analytics</td><td>Anonymized page views</td></tr>
          <tr><td>Google AdSense</td><td>Advertising</td><td>Cookies (Google-controlled)</td></tr>
          <tr><td>Frankfurter API</td><td>Currency exchange rates</td><td>No user data sent</td></tr>
        </tbody>
      </table>
    </section>

    <section>
      <h2>Data Security</h2>
      <ul>
        <li>All connections use <strong>HTTPS</strong> (TLS 1.3)</li>
        <li>Content Security Policy headers prevent XSS attacks</li>
        <li>X-Frame-Options: DENY prevents clickjacking</li>
        <li>No user accounts = no account data to breach</li>
        <li>Conversions happen client-side — values never leave your browser</li>
      </ul>
    </section>

    <section>
      <h2>Your Rights</h2>
      <p>Since we don't collect personal data beyond standard server logs:</p>
      <ul>
        <li><strong>No data to access</strong> — we don't have your personal information</li>
        <li><strong>No data to delete</strong> — we don't store your conversion history</li>
        <li><strong>No data to port</strong> — we don't have profiles to export</li>
      </ul>
      <p>If you have questions about Cloudflare's data practices, see <a href="https://www.cloudflare.com/privacypolicy/" target="_blank" rel="noopener">Cloudflare's Privacy Policy</a>.</p>
    </section>

    <section>
      <h2>Children's Privacy</h2>
      <p>ConvUnit is a general-purpose tool suitable for all ages. We do not knowingly collect data from children, and we do not target children with advertising.</p>
    </section>

    <section>
      <h2>Changes to This Policy</h2>
      <p>We may update this policy occasionally. Changes will be posted on this page with a new "Last updated" date. Continued use of ConvUnit after changes constitutes acceptance.</p>
    </section>

    <section>
      <h2>Contact</h2>
      <p>For privacy questions, visit our <a href="/en/about/">About page</a>.</p>
    </section>
  </article>
</BaseLayout>

<style>
  .trust-page { max-width: 720px; margin: 0 auto; }
  .trust-page h1 {
    font-size: var(--text-3xl);
    font-weight: 700;
    letter-spacing: -0.03em;
    margin-bottom: var(--sp-2);
  }
  .updated {
    color: var(--c-text-tertiary);
    font-size: var(--text-sm);
    margin-bottom: var(--sp-6);
  }
  .trust-page h2 {
    font-size: var(--text-xl);
    font-weight: 700;
    margin: var(--sp-8) 0 var(--sp-3);
    padding-bottom: var(--sp-2);
    border-bottom: 3px solid var(--c-accent);
  }
  .trust-page h3 {
    font-size: var(--text-base);
    font-weight: 700;
    margin: var(--sp-4) 0 var(--sp-2);
  }
  .trust-page p {
    line-height: 1.7;
    color: var(--c-text-secondary);
    margin-bottom: var(--sp-3);
  }
  .trust-page ul {
    padding-left: var(--sp-6);
    margin-bottom: var(--sp-4);
  }
  .trust-page li {
    line-height: 1.7;
    color: var(--c-text-secondary);
    margin-bottom: var(--sp-1);
  }
  .trust-page a {
    color: var(--c-link);
    text-decoration: underline;
    text-underline-offset: 2px;
  }
  .trust-page a:hover { color: var(--c-link-hover); }
  .services-table {
    width: 100%;
    border-collapse: collapse;
    margin: var(--sp-4) 0;
  }
  .services-table th {
    text-align: left;
    padding: var(--sp-2) var(--sp-3);
    background: var(--c-accent);
    font-size: var(--text-sm);
    font-weight: 700;
    border: var(--b);
  }
  .services-table td {
    padding: var(--sp-2) var(--sp-3);
    font-size: var(--text-sm);
    color: var(--c-text-secondary);
    border: var(--b);
  }
</style>