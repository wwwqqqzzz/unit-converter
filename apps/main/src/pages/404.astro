---
// 404 page — served for unknown routes and invalid conversion slugs.
// Astro forces a 404 status for this route, so `Astro.rewrite('/404')` from
// other pages reliably produces a real 404 instead of a soft 404.
import BaseLayout from '../layouts/BaseLayout.astro';

const lang = 'en';
const title = 'Page not found — Unit Converter';
const description = 'The page you requested does not exist. Browse our unit conversion categories instead.';

const popular = [
  { href: '/en/length/', label: 'Length' },
  { href: '/en/weight/', label: 'Weight' },
  { href: '/en/temperature/', label: 'Temperature' },
  { href: '/en/volume/', label: 'Volume' },
  { href: '/en/speed/', label: 'Speed' },
  { href: '/en/data/', label: 'Data Storage' },
  { href: '/en/area/', label: 'Area' },
  { href: '/en/time/', label: 'Time' },
];
---

<BaseLayout lang={lang} title={title} description={description} pagePath="404">
  <h1>Page not found</h1>
  <p>
    This conversion does not exist, or the URL is incorrect. All conversions are
    available from the category pages below.
  </p>

  <section class="links">
    <h2>Popular categories</h2>
    <ul>
      {popular.map(p => (
        <li><a href={p.href}>{p.label}</a></li>
      ))}
    </ul>
  </section>

  <p><a href="/en/">← Back to the converter</a></p>
</BaseLayout>

<style>
  h1 { font-size: var(--text-2xl); margin: var(--sp-6) 0 var(--sp-4); letter-spacing: -0.01em; }
  h2 { font-size: var(--text-xs); font-weight: 700; text-transform: uppercase; letter-spacing: 0.1em; color: var(--c-text-tertiary); margin-bottom: var(--sp-3); }
  .links { margin: var(--sp-8) 0; }
  .links ul { list-style: none; padding: 0; display: flex; flex-wrap: wrap; gap: var(--sp-2); }
  .links a {
    display: inline-block; padding: var(--sp-2) var(--sp-3);
    background: var(--c-surface); border: 2px solid var(--c-border);
    text-decoration: none; color: var(--c-text);
  }
  .links a:hover { background: var(--c-accent); }
</style>
