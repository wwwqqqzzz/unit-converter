---
import type { Unit } from 'converter-core/data/units';
import type { Lang } from 'converter-core/utils/i18n';
import { t } from 'converter-core/utils/i18n';
import { getDescriptionText } from 'converter-core/data/descriptions/index';
import { unitAnalogies } from 'converter-core/data/analogies';

export interface Props { lang: Lang; unit: Unit; categoryId: string; }
const { lang, unit, categoryId } = Astro.props;
const text = getDescriptionText(categoryId, unit.id, lang);
const analogy = unitAnalogies[categoryId]?.[unit.id];
if (!text && !analogy) return;
const analogyText = analogy ? (analogy[lang] || analogy.en) : undefined;
if (!text && !analogyText) return;
const label = t(lang, 'converter.aboutUnit', { unit: unit.name[lang] });
---

<section class="unit-desc">
  {text && <><h3 class="unit-desc-title">{label}</h3><p>{text}</p></>}
  {analogyText && <p class="unit-analogy">💡 {analogyText}</p>}
</section>

<style>
  .unit-desc {
    margin: var(--sp-4) 0;
    padding: var(--sp-4);
    border: 2px solid var(--c-border);
    background: var(--c-surface);
  }
  .unit-desc-title {
    font-size: var(--text-sm);
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: var(--c-text-tertiary);
    margin-bottom: var(--sp-2);
  }
  .unit-desc p {
    margin: 0;
    font-size: var(--text-sm);
    line-height: 1.7;
    color: var(--c-text-secondary);
  }
  .unit-analogy {
    margin-top: var(--sp-2) !important;
    padding: var(--sp-2) var(--sp-3);
    background: var(--c-accent);
    border: 2px solid var(--c-border);
    font-weight: 600;
    color: var(--c-text);
  }
</style>