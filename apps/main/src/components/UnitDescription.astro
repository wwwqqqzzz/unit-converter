---
// Unit description — Neo-Brutalist (always visible for AEO)
import type { Unit } from 'converter-core/data/units';
import type { Lang } from 'converter-core/utils/i18n';
import { t } from 'converter-core/utils/i18n';
import { unitDescriptions } from 'converter-core/data/descriptions';

export interface Props { lang: Lang; unit: Unit; categoryId: string; }
const { lang, unit, categoryId } = Astro.props;
const desc = unitDescriptions[categoryId]?.[unit.id];
if (!desc) return;
const text = desc[lang] || desc.en;
if (!text) return;
const label = t(lang, 'converter.aboutUnit', { unit: unit.name[lang] });
---

<section class="unit-desc">
  <h3 class="unit-desc-title">{label}</h3>
  <p>{text}</p>
</section>

<style>
  .unit-desc {
    margin: var(--sp-4) 0;
    padding: var(--sp-4);
    border: 2px solid var(--c-border);
    background: var(--c-surface);
  }
  .unit-desc-title {
    font-size: var(--text-sm);
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: var(--c-text-tertiary);
    margin-bottom: var(--sp-2);
  }
  .unit-desc p {
    margin: 0;
    font-size: var(--text-sm);
    line-height: 1.7;
    color: var(--c-text-secondary);
  }
</style>