---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import AgeCalc from '../../../components/Age.astro';
import { t, type Lang, LANGUAGES } from 'converter-core/utils/i18n';

export const prerender = true;
export async function getStaticPaths() {
  const langs = ['en','zh','es','fr','de','ja','pt','it','ko','ru','hi','tr'];
  return langs.map(lang => ({ params: { lang } }));
}

const { lang } = Astro.params as { lang: Lang };
const title = t(lang, 'calc.age.title') + ' | ConvUnit';
const description = t(lang, 'calc.age.metaDesc');
---

<BaseLayout title={title} description={description} lang={lang} path="age/">
  <article>
    <div style="background: var(--card); border: var(--border); box-shadow: var(--shadow); padding: 2rem; margin-bottom: 2rem;">
      <AgeCalc lang={lang} />
    </div>

    <!-- AdSense: Middle -->
    <div class="ad-container" style="margin: 2rem 0; text-align: center; min-height: 100px;">
      <ins class="adsbygoogle"
        style="display:block"
        data-ad-client="ca-pub-4967918867986181"
        data-ad-slot="9477105493"
        data-ad-format="auto"
        data-full-width-responsive="true"></ins>
      <script is:inline>(adsbygoogle = window.adsbygoogle || []).push({});</script>
    </div>

    <section style="background: var(--card); border: var(--border); box-shadow: var(--shadow); padding: 2rem;">
      <h2 style="font-size: 1.5rem; margin-bottom: 1rem;">{t(lang, 'calc.age.faqTitle')}</h2>
      <details style="margin-bottom: 0.75rem;"><summary style="cursor: pointer; font-weight: 600;">{t(lang, 'calc.age.faq1q')}</summary><p style="margin-top: 0.5rem; color: var(--text-muted);">{t(lang, 'calc.age.faq1a')}</p></details>
      <details style="margin-bottom: 0.75rem;"><summary style="cursor: pointer; font-weight: 600;">{t(lang, 'calc.age.faq2q')}</summary><p style="margin-top: 0.5rem; color: var(--text-muted);">{t(lang, 'calc.age.faq2a')}</p></details>
      <details style="margin-bottom: 0.75rem;"><summary style="cursor: pointer; font-weight: 600;">{t(lang, 'calc.age.faq3q')}</summary><p style="margin-top: 0.5rem; color: var(--text-muted);">{t(lang, 'calc.age.faq3a')}</p></details>
    </section>

    <!-- AdSense: Bottom -->
    <div class="ad-container" style="margin: 2rem 0; text-align: center; min-height: 100px;">
      <ins class="adsbygoogle"
        style="display:block"
        data-ad-client="ca-pub-4967918867986181"
        data-ad-slot="9477105493"
        data-ad-format="horizontal"
        data-full-width-responsive="true"></ins>
      <script is:inline>(adsbygoogle = window.adsbygoogle || []).push({});</script>
    </div>
  </article>
</BaseLayout>

<script type="application/ld+json" set:html={JSON.stringify({
  "@context": "https://schema.org",
  "@type": ["WebApplication"],
  "name": t(lang, 'calc.age.title'),
  "description": t(lang, 'calc.age.metaDesc'),
  "url": `https://age.convunit.net/${lang}/age/`,
  "applicationCategory": "UtilitiesApplication",
  "operatingSystem": "All"
})} />
